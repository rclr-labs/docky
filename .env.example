# ============================================================================
# DOCKY - Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env e preenchcha com seus valores

# ============================================================================
# API
# ============================================================================
# Porta do servidor FastAPI
API_PORT=8000
API_HOST=0.0.0.0
# DEBUG mode
DEBUG=False
LOG_LEVEL=INFO

# ============================================================================
# QDRANT - Vector Database
# ============================================================================
# Endereço do serviço Qdrant
QDRANT_URL=http://qdrant:6333
# Chave de API (opcional, se habilitada)
QDRANT_API_KEY=
# Nome da collection padrão
QDRANT_COLLECTION_NAME=docky_documents

# ============================================================================
# OLLAMA - Local LLM
# ============================================================================
# Endereço do serviço Ollama
OLLAMA_BASE_URL=http://ollama:11434
# Modelo padrão para LLM
OLLAMA_MODEL=mistral
# Temperatura para geração (0.0 - 1.0)
OLLAMA_TEMPERATURE=0.7

# ============================================================================
# EMBEDDINGS - Sentence Transformers
# ============================================================================
# Modelo de embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Dimensão dos embeddings (depende do modelo)
EMBEDDING_DIMENSION=384
# Dispositivo para embeddings (cpu ou cuda)
EMBEDDING_DEVICE=cpu

# ============================================================================
# DOCUMENT INGESTION
# ============================================================================
# Diretório para documentos a serem ingeridos
INGEST_SOURCE_DIR=/data/raw
# Diretório para documentos processados
INGEST_PROCESSED_DIR=/data/processed
# Extensões de arquivo a processar (separadas por vírgula)
INGEST_FILE_EXTENSIONS=.pdf,.docx,.md,.txt
# Tamanho máximo de arquivo em MB
INGEST_MAX_FILE_SIZE_MB=50

# ============================================================================
# RAG / RETRIEVAL
# ============================================================================
# Número de documentos a recuperar (top-k retrieval)
RETRIEVAL_TOP_K=5
# Threshold de similaridade para filtrar resultados (0.0 - 1.0)
RETRIEVAL_SIMILARITY_THRESHOLD=0.5
# Ativar re-ranking de resultados
ENABLE_RERANKING=true

# ============================================================================
# SECURITY
# ============================================================================
# Chave secreta da API (altere em produção!)
API_SECRET_KEY=your-secret-key-change-in-production
# CORS origins permitidas
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# DATABASE (para metadados, se necessário)
# ============================================================================
# URL da conexão (SQLite local por padrão)
DATABASE_URL=sqlite:///./docky.db

# ============================================================================
# CACHE
# ============================================================================
# Ativar cache de embeddings
ENABLE_CACHE=true
# TTL do cache em segundos
CACHE_TTL_SECONDS=3600
